# Configuraci\u00f3n local para docker compose (copiar a .env y completar)
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# En local sin Cognito: dejar COGNITO_ENABLED=false (registro funciona contra la BD).
# En AWS/EKS: COGNITO_ENABLED=true + credenciales del cluster (Pod Identity).
COGNITO_ENABLED=false
IDENTITY_SERVICE_URL=http://identity_service:8000
MOCK_KYC_STATUS=PASSED
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin