# Configuracion local de Docker Compose (copiar a .env y completar)

# Common
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/identity_db

# Identity Service
CONSENT_TERMS_VERSION=1.0
CONSENT_CACHE_TTL_SECONDS=300
KYC_SERVICE_URL=http://mock_kyc:8000
KYC_TIMEOUT_SECONDS=5.0
KYC_PROVIDER_NAME=mock_kyc
KYC_DOCUMENT_MAX_BYTES=5242880
# s3 (predeterminado) o local (solo desarrollo, usa /tmp)
KYC_DOCUMENT_STORAGE=local
LIVENESS_ADAPTER_URL=http://liveness_adapter:8000
LIVENESS_PROVIDER=propio
LIVENESS_SESSION_TTL_SECONDS=120
MAX_FRAME_BYTES=524288
DIDIT_ENABLED=false
DIDIT_BASE_URL=http://mock_kyc:8000
DIDIT_MAX_SESIONES_DIA=5
DIDIT_MAX_SESIONES_MES=100
MOCK_DIDIT_STATUS=Approved
# Solo en .env local o Secrets Manager; sin token, /admin/liveness-provider responde 403.
LIVENESS_ADMIN_TOKEN=
# Didit real (solo demostración, costo cero: app sandbox o workflow solo passive liveness).
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
GRPC_ENABLED=true
GRPC_PORT=50051
OPEN_FINANCE_URL=http://mock_openfinance:8000
OPEN_FINANCE_TIMEOUT_SECONDS=0.2

# Quoting Engine Service
RATING_CACHE_TTL_SECONDS=300
COTIZACION_VIGENCIA_DIAS=15
SEED_ON_STARTUP=true
IDENTITY_GRPC_ADDRESS=identity_service:50051
IDENTITY_GRPC_TIMEOUT_SECONDS=0.12
IDENTITY_GRPC_MAX_CONCURRENCY=100
IDENTITY_CB_FAILURE_THRESHOLD=5
IDENTITY_CB_RECOVERY_SECONDS=10
OPEN_DATA_URL=http://mock_opendata:8000
OPEN_DATA_TIMEOUT_SECONDS=0.25
OPEN_DATA_CACHE_TTL_SECONDS=300

# Insurance Policies Service
FIRMA_MAX_REQUEST_BYTES=2097152
# s3 (predeterminado) o local (solo desarrollo, usa /tmp)
FIRMA_STORAGE=local

# Web BFF
IDENTITY_SERVICE_URL=http://identity_service:8002
QUOTINGENGINE_SERVICE_URL=http://quotingengine_service:8003
INSURANCEPOLICIES_SERVICE_URL=http://insurancepolicies_service:8004

# Mock KYC
MOCK_KYC_STATUS=PASSED
MOCK_AML_STATUS=PASSED

# Mock Open Finance
MOCK_OPENFINANCE_STATUS=AVAILABLE
MOCK_OPENFINANCE_DELAY_MS=0
MOCK_OPENFINANCE_INCOME=8500000
MOCK_OPENFINANCE_SAVINGS=25500000
MOCK_OPENFINANCE_DTI=28
MOCK_OPENFINANCE_OVERDRAFTS=0
MOCK_OPENFINANCE_SCORE=820

# Mock Open Data
MOCK_OPENDATA_STATUS=AVAILABLE
MOCK_OPENDATA_DELAY_MS=0
MOCK_OPENDATA_CATEGORY=

# AWS Auth
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Identity provider (AWS Cognito)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1
# Local: keep false to use the Noop identity provider.
# AWS/EKS: set true and provide Cognito identifiers and workload credentials.
COGNITO_ENABLED=false

# PostgreSQL
POSTGRES_DB=identity_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_ENDPOINT=redis://redis:6379/0
REDIS_AUTH_TOKEN=

# S3 Bucket
S3_BUCKET_NAME=

# KMS Key
KMS_KEY_ARN=

# Solo para demostración local de activación sin JWT. Nunca usar fuera de development.
ALLOW_DEMO_ACTIVATION_WITHOUT_JWT=false
BFF_MOBILE_ENVIRONMENT=development

# OpenTelemetry Observability and Grafana
OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4317
OTEL_TRACES_EXPORTER=otlp
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
