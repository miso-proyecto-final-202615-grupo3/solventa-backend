FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# WeasyPrint (certificado PDF de la póliza) necesita Pango y fuentes del sistema.
RUN apt-get update && \
    apt-get install -y --no-install-recommends libpango-1.0-0 libpangoft2-1.0-0 fonts-dejavu-core && \
    rm -rf /var/lib/apt/lists/*

COPY insurancepolicies_service/requirements.txt ./
COPY README.md ./
COPY insurancepolicies_service/src ./src

RUN pip install --upgrade pip && \
    pip install -r requirements.txt

EXPOSE 8000

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
