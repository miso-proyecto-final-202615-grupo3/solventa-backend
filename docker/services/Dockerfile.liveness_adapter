FROM python:3.13-slim
WORKDIR /app
COPY liveness_adapter/requirements.txt ./
COPY liveness_adapter/src ./src
RUN pip install --no-cache-dir -r requirements.txt \
    && mkdir -p /app/models \
    && python -c "import urllib.request; urllib.request.urlretrieve('https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/latest/face_landmarker.task', '/app/models/face_landmarker.task')"
EXPOSE 8000
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
