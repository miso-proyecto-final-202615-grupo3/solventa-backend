# Configuracion local de Docker Compose (copiar a .env y completar)
# Identity service
PROJECT_NAME=solventa
VERSION=0.1.0
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/identity_db
CONSENT_TERMS_VERSION=1.0
CONSENT_CACHE_TTL_SECONDS=300
KYC_SERVICE_URL=http://mock_kyc:8000
KYC_TIMEOUT_SECONDS=0.7
OPEN_FINANCE_URL=http://mock_open_finance:8000
OPEN_FINANCE_TIMEOUT_SECONDS=0.2
IDENTITY_GRPC_TIMEOUT_SECONDS=0.3
IDENTITY_GRPC_PORT=50051
IDENTITY_GRPC_TARGET=identity_service:50051
OPEN_DATA_URL=http://mock_open_data:8000
OPEN_DATA_TIMEOUT_SECONDS=0.25
OPEN_DATA_CACHE_TTL_SECONDS=300

# Redis consent and profile cache
REDIS_ENDPOINT=redis://redis:6379/0
REDIS_AUTH_TOKEN=

# Identity provider (AWS Cognito)
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Local: keep false to use the Noop identity provider.
# AWS/EKS: set true and provide Cognito identifiers and workload credentials.
COGNITO_ENABLED=false

# PostgreSQL
POSTGRES_DB=identity_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Web BFF
IDENTITY_SERVICE_URL=http://identity_service:8000
MOTOR_COTIZACION_URL=http://motor_cotizacion:8000

# Mock KYC
MOCK_KYC_STATUS=PASSED

# Mock Open Finance
MOCK_OPEN_FINANCE_STATUS=AVAILABLE
MOCK_OPEN_FINANCE_DELAY_MS=0
MOCK_OPEN_FINANCE_INCOME=8500000
MOCK_OPEN_FINANCE_SAVINGS=25500000
MOCK_OPEN_FINANCE_DTI=28
MOCK_OPEN_FINANCE_OVERDRAFTS=0
MOCK_OPEN_FINANCE_SCORE=820

# Mock Open Data
MOCK_OPEN_DATA_STATUS=AVAILABLE
MOCK_OPEN_DATA_DELAY_MS=0
MOCK_OPEN_DATA_CATEGORY=

# Observability and Grafana
OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4317
OTEL_TRACES_EXPORTER=none
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
