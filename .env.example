# Configuracion local de Docker Compose (copiar a .env y completar)

# Identity Service
PROJECT_NAME=solventa
VERSION=0.1.0
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/appdb
CONSENT_TERMS_VERSION=1.0
CONSENT_CACHE_TTL_SECONDS=300
KYC_SERVICE_URL=http://mock_kyc:8000
KYC_TIMEOUT_SECONDS=0.7
GRPC_ENABLED=true
GRPC_PORT=50051

# Quoting Engine Service
IDENTITY_GRPC_ADDRESS=identity_service:50051

# Web BFF
IDENTITY_SERVICE_URL=http://identity_service:8000
QUOTINGENGINE_SERVICE_URL=http://quotingengine_service:8000

# Mock KYC
MOCK_KYC_STATUS=PASSED

# AWS Auth
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Identity provider (AWS Cognito)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Local: keep false to use the Noop identity provider.
# AWS/EKS: set true and provide Cognito identifiers and workload credentials.
COGNITO_ENABLED=true

# PostgreSQL
POSTGRES_DB=appdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_ENDPOINT=redis://redis:6379/0
REDIS_AUTH_TOKEN=

# OpenTelemetry Observability and Grafana
OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4317
OTEL_TRACES_EXPORTER=otlp
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# URL base para tests de sistema (p. ej. http://localhost:8002 o el load balancer)
SYSTEM_TESTS_BASE_URL=http://localhost:8000
